   "source": [
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "OUTPUT_FILE = Path(\"Knowledge Base/Processed/kb_chunks.jsonl\")\n",
    "\n",
    "with OUTPUT_FILE.open(\"r\", encoding=\"utf-8\") as f:\n",
    "    kb_chunks = [json.loads(line) for line in f]\n",
    "\n",
    "print(f\"Loaded {len(kb_chunks)} KB chunks.\")"
   ]
  }
